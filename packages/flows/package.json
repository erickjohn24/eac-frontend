{
  "name": "@tz/flows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx ./src/**/*.test.ts"
  },
  "dependencies": {
    "@tz/agent-core": "workspace:*",
    "@tz/shared": "workspace:*",
    "pdfkit": "^0.15.1",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
